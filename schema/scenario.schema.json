{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Moresweet/carla-safety-agent/schema/scenario.schema.json",
  "title": "CARLA Safety Scenario",
  "type": "object",
  "required": ["scenario_id", "family", "map_name", "seed", "ego", "adversaries", "environment", "oracle"],
  "properties": {
    "scenario_id": {"type": "string", "minLength": 1},
    "family": {
      "enum": ["rear_end", "lead_vehicle_lane_change", "vulnerable_road_user", "crossing_path", "merge"]
    },
    "map_name": {"type": "string", "pattern": "^Town[0-9]{2}$"},
    "seed": {"type": "integer", "minimum": 0},
    "ego": {"$ref": "#/$defs/actor"},
    "adversaries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/actor"}},
    "environment": {"type": "object"},
    "oracle": {"type": "object"},
    "provenance": {"type": "object"}
  },
  "$defs": {
    "actor": {
      "type": "object",
      "required": ["role", "blueprint", "spawn_index", "speed_mps", "behavior"],
      "properties": {
        "role": {"type": "string"},
        "blueprint": {"type": "string"},
        "spawn_index": {"type": "integer", "minimum": 0},
        "speed_mps": {"type": "number", "minimum": 0},
        "trigger_distance_m": {"type": ["number", "null"], "minimum": 0},
        "behavior": {"type": "string"}
      }
    }
  }
}
