+    ParentRenderStateDirtyHandle = UActorComponent::MarkRenderStateDirtyEvent.AddUObject(
+        this, &UTaggedComponent::OnParentRenderStateDirty);
+  }
 }
 
+void UTaggedComponent::OnUnregister()
+{
+  UActorComponent::MarkRenderStateDirtyEvent.Remove(ParentRenderStateDirtyHandle);
+  ParentRenderStateDirtyHandle.Reset();
+  Super::OnUnregister();
+}
+
+void UTaggedComponent::OnParentRenderStateDirty(UActorComponent& Component)
+{
+  if (&Component != GetAttachParent() || !IsRegistered()) return;
+  // The annotation proxy borrows the parent's MeshObject. MarkRenderStateDirty
+  // runs before the parent's queued recreation releases that object. Retire the
+  // annotation now, not on a later tick when the old resource may be gone.
+  check(IsInGameThread());
+  bShouldWaitFrame = true;
+  NumFramesToWait = 3;
+  if (IsRenderStateCreated())
+  {
+    RecreateRenderState_Concurrent();
+    FlushRenderingCommands();
+  }
+}
