+void ACollisionSensor::UnbindCollisionOwner()
+{
+  AActor *PreviousOwner = GetOwner();
+  if (auto *Vehicle = Cast<ACarlaWheeledVehicle>(PreviousOwner))
+  {
+    if (IsValid(Vehicle->GetMesh()))
+      Vehicle->GetMesh()->OnComponentHit.RemoveDynamic(this, &ACollisionSensor::OnComponentCollisionEvent);
+  }
+  else if (auto *Walker = Cast<AWalkerBase>(PreviousOwner))
+  {
+    if (IsValid(Walker->GetMesh()))
+      Walker->GetMesh()->OnComponentHit.RemoveDynamic(this, &ACollisionSensor::OnComponentCollisionEvent);
+  }
+  OnActorHit.RemoveDynamic(this, &ACollisionSensor::OnActorCollisionEvent);
+}
+
+void ACollisionSensor::EndPlay(EEndPlayReason::Type EndPlayReason)
+{
+  // Stop physics delegates before ASensor closes its stream and deregisters.
+  bCollisionEndingPlay = true;
+  UnbindCollisionOwner();
+  CollisionRegistry.clear();
+  Super::EndPlay(EndPlayReason);
+}
