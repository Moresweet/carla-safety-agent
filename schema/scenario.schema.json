{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Moresweet/carla-safety-agent/schema/scenario.schema.json",
  "title": "CARLA Safety Scenario",
  "type": "object",
  "required": ["scenario_id", "family", "map_name", "seed", "ego", "adversaries", "environment", "oracle"],
  "properties": {
    "scenario_id": {"type": "string", "minLength": 1},
    "family": {
      "enum": ["rear_end", "lead_vehicle_lane_change", "vulnerable_road_user", "crossing_path", "merge", "road_hazard"]
    },
    "map_name": {"type": "string", "pattern": "^(Town[0-9]{2}|GeneratedOpenDrive)$"},
    "seed": {"type": "integer", "minimum": 0},
    "ego": {"$ref": "#/$defs/actor"},
    "adversaries": {"type": "array", "items": {"$ref": "#/$defs/actor"}},
    "generated_assets": {"type": "array", "items": {"$ref": "#/$defs/generated_asset"}},
    "generated_map": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/generated_map"}]},
    "environment": {"type": "object"},
    "oracle": {"type": "object"},
    "provenance": {"type": "object"}
  },
  "$defs": {
    "generated_map": {
      "type": "object",
      "required": ["name", "segments", "lane_width_m", "lanes_each_direction", "speed_limit_mps"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "segments": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["kind", "length_m", "curvature"],
            "properties": {
              "kind": {"enum": ["line", "arc"]},
              "length_m": {"type": "number", "exclusiveMinimum": 0},
              "curvature": {"type": "number"},
              "grade": {"type": "number", "minimum": -0.15, "maximum": 0.15}
            }
          }
        },
        "lane_width_m": {"type": "number", "exclusiveMinimum": 0},
        "lanes_each_direction": {"type": "integer", "minimum": 1},
        "speed_limit_mps": {"type": "number", "exclusiveMinimum": 0}
        ,"realistic_environment": {"type": "boolean"}
        ,"tree_count": {"type": "integer", "minimum": 0}
        ,"building_count": {"type": "integer", "minimum": 0}
        ,"pedestrian_count": {"type": "integer", "minimum": 0}
        ,"traffic_vehicle_count": {"type": "integer", "minimum": 0}
      }
    },
    "generated_asset": {
      "type": "object",
      "required": ["asset_id", "kind", "shape", "dimensions_m", "mass_kg", "distance_ahead_m", "count"],
      "properties": {
        "asset_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["fallen_cargo", "roadside_occluder"]},
        "shape": {"enum": ["metal_pipes", "concrete_barriers"]},
        "dimensions_m": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": {"type": "number", "exclusiveMinimum": 0}
        },
        "mass_kg": {"type": "number", "minimum": 0},
        "distance_ahead_m": {"type": "number", "exclusiveMinimum": 0},
        "lateral_offset_m": {"type": "number"},
        "count": {"type": "integer", "minimum": 1},
        "color": {"type": "string"}
      }
    },
    "actor": {
      "type": "object",
      "required": ["role", "blueprint", "spawn_index", "speed_mps", "behavior"],
      "properties": {
        "role": {"type": "string"},
        "blueprint": {"type": "string"},
        "spawn_index": {"type": "integer", "minimum": 0},
        "speed_mps": {"type": "number", "minimum": 0},
        "trigger_distance_m": {"type": ["number", "null"], "minimum": 0},
        "behavior": {"type": "string"}
      }
    }
  }
}
