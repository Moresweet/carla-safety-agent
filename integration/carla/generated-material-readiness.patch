   const FVector MeshScale(ScaleX, ScaleY, ScaleZ);
 
+  const FString MeshPath = ABFL::RetrieveActorAttributeToString(
+      "mesh_path", ActorDescription.Variations, "");
+  UStaticMesh *Mesh = LoadObject<UStaticMesh>(nullptr, *MeshPath);
+  if (!Mesh)
+  {
+    UE_LOG(LogCarla, Error, TEXT("Static mesh asset could not be loaded: %s"), *MeshPath);
+    return {};
+  }
+#if WITH_EDITOR
+  // Newly imported editor assets compile shaders on first runtime load. Do not
+  // expose an actor to RGB sensors while its real material is still pending.
+  // Wait only for this generated asset's materials, never all editor shaders.
+  if (MeshPath.StartsWith(TEXT("/Game/Carla/Static/Generated/")))
+  {
+    for (const FStaticMaterial &Slot : Mesh->StaticMaterials)
+    {
+      UMaterialInterface *Material = Slot.MaterialInterface;
+      FMaterialResource *Resource = Material ? Material->GetMaterialResource(World->FeatureLevel) : nullptr;
+      if (!Resource)
+      {
+        UE_LOG(LogCarla, Error, TEXT("Generated mesh material resource is missing: %s"), *MeshPath);
+        return {};
+      }
+      Resource->FinishCompilation();
+      if (!Resource->HasValidGameThreadShaderMap())
+      {
+        UE_LOG(LogCarla, Error, TEXT("Generated mesh material compilation failed: %s"), *MeshPath);
+        return {};
+      }
+    }
+    FlushRenderingCommands();
+  }
+#endif
