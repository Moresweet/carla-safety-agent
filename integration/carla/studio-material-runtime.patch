+bool ACarlaGameModeBase::ApplyTextureToActorSlot(
+    AActor* Actor, UTexture2D* Texture, const FString& ComponentName,
+    int32 Slot, bool bRestore)
+{
+  if (!Actor || Slot < 0) return false;
+  TArray<UMeshComponent*> Meshes;
+  Actor->GetComponents(Meshes);
+  UMeshComponent* Selected = nullptr;
+  for (UMeshComponent* Mesh : Meshes)
+  {
+    // Tagged copies are renderer internals, never user material targets.
+    if (Mesh->IsA<UTaggedComponent>()) continue;
+    if (ComponentName.IsEmpty() || Mesh->GetName() == ComponentName)
+    {
+      if (Selected) return false; // Ambiguous component selection.
+      Selected = Mesh;
+    }
+  }
+  if (!Selected || Slot >= Selected->GetNumMaterials()) return false;
+  const FString Key = Selected->GetPathName() + TEXT("::") + FString::FromInt(Slot);
+  UMaterialInterface* Material = nullptr;
+  if (bRestore)
+  {
+    UMaterialInterface** Saved = StudioOriginalMaterials.Find(Key);
+    if (!Saved) return false;
+    Material = *Saved;
+  }
+  else
+  {
+    UMaterialInterface* Base = LoadObject<UMaterialInterface>(nullptr,
+        TEXT("/Game/Carla/Static/GenericMaterials/M_CarlaVehicleLiveryRuntime.M_CarlaVehicleLiveryRuntime"));
+    if (!Base || !Texture) return false;
+    UMaterialInstanceDynamic* Dynamic = UMaterialInstanceDynamic::Create(Base, Selected);
+    if (!Dynamic) return false;
+    if (!StudioOriginalMaterials.Contains(Key))
+      StudioOriginalMaterials.Add(Key, Selected->GetMaterial(Slot));
+    Dynamic->SetTextureParameterValue(TEXT("LiveryTexture"), Texture);
+    Dynamic->SetTextureParameterValue(TEXT("Diffuse"), Texture);
+    Material = Dynamic;
+  }
+  if (UTaggedComponent* Tagged = ATagger::FindTaggedComponent(Selected))
+    Tagged->WaitForParentSkeletalMesh();
+  FlushRenderingCommands();
+  Selected->SetMaterial(Slot, Material);
+  if (UTaggedComponent* Tagged = ATagger::FindTaggedComponent(Selected))
+    Tagged->MarkRenderStateDirty();
+  FlushRenderingCommands();
+  if (bRestore) StudioOriginalMaterials.Remove(Key);
+  return true;
+}
