Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: map
  Displays:
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
    - Class: rviz_default_plugins/PointCloud2
      Name: LiDAR
      Enabled: true
      Topic:
        Value: /carla/ego/lidar/points
      Size (Pixels): 2
    - Class: rviz_default_plugins/Image
      Name: RGB
      Enabled: true
      Topic:
        Value: /carla/ego/rgb/image
    - Class: rviz_default_plugins/Image
      Name: Semantic
      Enabled: true
      Topic:
        Value: /carla/ego/semantic/image
    - Class: rviz_default_plugins/Odometry
      Name: Ego Odometry
      Enabled: true
      Topic:
        Value: /carla/ego/odometry
